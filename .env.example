# ==============================================================
# JerseyAI Environment Configuration Template (.env.example)
# ==============================================================

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security & JWT Authentication
JWT_SECRET_KEY=replace_with_a_secure_random_64_char_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/jerseyai_db

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Image Generation Provider (e.g. Gemini / Stability / OpenAI / Fal)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
# STABILITY_API_KEY=your_stability_api_key
# OPENAI_API_KEY=your_openai_api_key
